<!DOCTYPE html>
<html>
<head><title>Success</title></head>
<body style="font-family: Arial, sans-serif; max-width: 520px; margin: 60px auto;">
  <h2 style="color: green;">Data submitted successfully</h2>
  <p><%= result.message %></p>
